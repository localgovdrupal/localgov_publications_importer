{
    "name": "localgovdrupal/localgov_publications_importer",
    "description": "PDF to HTML publication importer for the LocalGovDrupal distribution.",
    "type": "drupal-module",
    "homepage": "https://github.com/localgovdrupal/localgov_publications_importer",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "smalot/pdfparser": "^2.12.1"
    },
    "require-dev": {
        "localgovdrupal/localgov_publications_importer_test_data": "1.x-dev"
    },
    "extra": {
        "enable-patching": true,
        "patches": {
            "smalot/pdfparser": {
                "PDFObject:: getTextArray() shouldn't include XObject Forms.": "patches/smalot_pdfparser_pr_783_no_tests.patch"
            }
        }
    },
    "suggest": {
        "drupal/ai": "Format the imported PDF using an AI LLM (required by the submodule localgov_publications_importer_ai)"
    }
}
