From a23e53abfded68d24104dc5fb5d435943cecbeca Mon Sep 17 00:00:00 2001
From: Rupert Jabelman <rupert@jabelman.org>
Date: Thu, 30 Oct 2025 11:42:42 +0000
Subject: [PATCH] Ignore Form as well as Image XObjects when assembling the
 text array for a PDFObject.

---
 src/Smalot/PdfParser/PDFObject.php | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/Smalot/PdfParser/PDFObject.php b/src/Smalot/PdfParser/PDFObject.php
index bbbf08f7..61d23edb 100644
--- a/src/Smalot/PdfParser/PDFObject.php
+++ b/src/Smalot/PdfParser/PDFObject.php
@@ -788,8 +788,9 @@ public function getTextArray(?Page $page = null): array
                             break;
                         }

-                        // If the PDFObject is an image, do nothing, as images aren't text.
-                        if ($xobject instanceof Image) {
+                        // If the PDFObject is an Image or a Form, do nothing as
+                        // neither of these XObject types are text.
+                        if ($xobject instanceof Image || $xobject instanceof Form) {
                             break;
                         }
